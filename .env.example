# Salin file ini ke `.env` lalu sesuaikan bila perlu:  cp .env.example .env
# Nilai default di bawah aman untuk pemakaian LOKAL. Untuk non-lokal, GANTI password.

# ── ClickHouse (storage permanen OHLCV) ───────────────────────────────────────
CLICKHOUSE_HOST=clickhouse
CLICKHOUSE_HTTP_PORT=8123
CLICKHOUSE_USER=default
CLICKHOUSE_PASSWORD=tradingch123
CLICKHOUSE_DB=market

# ── PostgreSQL (journal, portfolio, transaksi) ────────────────────────────────
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_USER=trading
POSTGRES_PASSWORD=tradingpass123
# POSTGRES_HOST_PORT=5434          # ganti kalau 5432 di HOST bentrok (mis. server bareng project lain)
POSTGRES_DB=tradingdb

# ── Kafka ─────────────────────────────────────────────────────────────────────
KAFKA_BOOTSTRAP_SERVERS=kafka:29092

# ── Pipeline TCP (Yahoo → TCP → Kafka) ────────────────────────────────────────
TCP_HOST=ingestion
TCP_PORT=9009

# ── Ingestion (yFinance) ──────────────────────────────────────────────────────
POLL_INTERVAL=300                  # interval poll yFinance (detik)
CHART_INTERVALS=5m,15m,1h,1d,1wk   # timeframe yang di-fetch
# Sumber daftar emiten IDX (auto-fetch saat startup)
UNIVERSE_URL=https://raw.githubusercontent.com/wildangunawan/Dataset-Saham-IDX/master/List%20Emiten/all.csv
CHUNK_SIZE=60                      # ticker per batch yf.download (hindari rate-limit)
REBACKFILL_HOURS=6                 # re-backfill penuh tiap N jam (self-heal)
MAX_SYMBOLS=0                      # 0 = semua ~951 emiten; >0 = batasi (subset)
# Proteksi 429 "Edge: Too Many Requests" Yahoo — rate-limit murni berbasis volume
# request per-IP, jadi cuma bisa dikurangi (bukan dilewati kayak bot-challenge).
YF_THREADS=5                       # concurrency per chunk (default yfinance = sebesar chunk, terlalu bursty)
CHUNK_DELAY_SECONDS=2              # jeda antar chunk saat normal
RATE_LIMIT_BACKOFF_SECONDS=60      # backoff dasar tiap kena 429 (dobel per hit beruntun, cap 300s)
RATE_LIMIT_MAX_CONSECUTIVE=3       # 429 beruntun sebanyak ini → abort pass, hindari makin diblokir
RATE_LIMIT_COOLDOWN_SECONDS=900    # cooldown sebelum coba pass lagi kalau di-abort krn 429

# ── Broker Summary per-saham (IndexAlpha, pihak ketiga berbayar, opsional) ────
# IDX resmi cuma punya broker summary agregat market-wide, bukan per-saham.
# Daftar gratis di indexalpha.id/pricing (5 request/hari) buat API key.
# MANUAL trigger saja (script/CLI) — jangan cron otomatis, quota terbatas & berbayar.
INDEXALPHA_API_KEY=                # kosong = fitur nonaktif
INDEXALPHA_SYMBOLS=                # comma-separated, kosong = tidak jalan (safety)

# ── AI Picks (Tab 3) — generate manual via tombol (tanpa auto/TTL) ────────────
AI_PICKS_TOP_N=15                  # jumlah saham bullish teratas yang dipilih

# ── LLM generik (OpenAI-compatible) untuk reasoning AI Picks ──────────────────
# KOSONGKAN LLM_BASE_URL = AI Picks tetap jalan (rule-based, tanpa reasoning), TANPA network call.
# Arahkan ke Ollama/vLLM/LocalAI/LM Studio self-hosted, BUKAN Claude API (biaya).
# Contoh Ollama:  LLM_BASE_URL=http://host.docker.internal:11434/v1  + LLM_MODEL=llama3.1
LLM_BASE_URL=                      # kosong = nonaktif (default)
LLM_MODEL=llama3.1
LLM_API_KEY=                       # isi bila endpoint butuh auth (vLLM/LocalAI), Ollama biasanya kosong
LLM_TIMEOUT_SECONDS=30
LLM_MAX_TOKENS=1500                # batas token output; set longgar utk reasoning model (thinking + jawaban)

# ── AI Advisor (Tab 5) — Hermes Agent via bridge HTTP, generate manual via tombol ─
# Bridge (`scripts/hermes_advisor_bridge.py`) jalan di mesin tempat Hermes
# (`bro_analysis`) terinstal. Dua topologi (lihat docs/hermes-server-migration.md):
#   a) App & Hermes di mesin sama (topologi lama, VPS):
#      HERMES_BRIDGE_URL=http://host.docker.internal:8090  (API key opsional)
#   b) App di laptop, Hermes tetap di VPS (topologi migrasi):
#      HERMES_BRIDGE_URL=http://<IP-Tailscale-atau-publik-VPS>:8090
#      dan HERMES_BRIDGE_API_KEY WAJIB (sama dgn env var di VPS tempat bridge jalan).
# Kalau bridge tidak terjangkau, AI Advisor tetap tampilkan data teknikal
# (ClickHouse), cuma narasi AI yang absen.
HERMES_BRIDGE_URL=http://host.docker.internal:8090
HERMES_BRIDGE_API_KEY=              # wajib utk topologi (b); kosong = header tidak dikirim
HERMES_BRIDGE_TIMEOUT_SECONDS=150   # longgar: init agent + LLM call bisa puluhan detik
# "Rekomendasi Hari Ini": Hermes SENDIRI yang menyeleksi (bukan cuma komentar) dari
# POOL_SIZE kandidat skor tertinggi (verdict apa pun, belum difilter bullish) →
# pilih maksimal DAILY_TOP_N yang genuinely lolos kriteria (boleh lebih sedikit).
AI_ADVISOR_POOL_SIZE=50             # jumlah kandidat yang dievaluasi Hermes
AI_ADVISOR_DAILY_TOP_N=8            # batas atas jumlah yang boleh dipilih Hermes
